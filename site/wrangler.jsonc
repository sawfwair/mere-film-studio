{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grace",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-04-09",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "d49787aa3908b52ac1bf58ba6d6375f1",
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "GRACE_RELEASES", "bucket_name": "grace-releases" }
  ],
  "vars": {
    "GRACE_RELEASE_VERSION": "0.1.0",
    "GRACE_RELEASE_SHA256": "582277f3c5e5fff2114236f8413d822449ff362d8a0438a3c8a828a462438abf"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "grace.mere.run", "custom_domain": true }
  ]
}
